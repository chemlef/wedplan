# --- Required in production -------------------------------------------------
# Turso database (create with: turso db create wedplan && turso db tokens create wedplan)
TURSO_DATABASE_URL=libsql://wedplan-<your-org>.turso.io
TURSO_AUTH_TOKEN=
# Long random string used to sign login cookies (e.g. `openssl rand -hex 32`)
SESSION_SECRET=
# Public URL of the app, used for RSVP links and OAuth redirects
APP_URL=https://wedplan.vercel.app

# --- Optional: Spotify (wedding playlist) ------------------------------------
# Redirect URI to register in the Spotify dashboard: $APP_URL/api/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Optional: Pinterest (import inspiration boards) -------------------------
# Redirect URI to register in the Pinterest app: $APP_URL/api/pinterest/callback
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# Local development: leave TURSO_* empty to use a local SQLite file in ./data
