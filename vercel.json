{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__path=:path*" },
    { "source": "/rsvp/:token", "destination": "/rsvp.html" },
    { "source": "/((?!api/|css/|js/|img/|rsvp\\.html|favicon).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/js/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ]
}
